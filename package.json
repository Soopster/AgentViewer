{
  "name": "agent-viewer",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "agent-viewer": "./bin/agent-viewer.mjs"
  },
  "files": [
    "README.md",
    "app",
    "bin",
    "components",
    "components.json",
    "instrumentation.ts",
    "lib",
    "next-env.d.ts",
    "next.config.ts",
    "package.json",
    "postcss.config.mjs",
    "proxy.ts",
    "tsconfig.json",
    "tsconfig.opentui.json",
    "tsconfig.tui.json",
    "tui",
    "workers"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tui": "bun run ./tui/opentui/main.tsx",
    "tui:dev": "bun --watch ./tui/opentui/main.tsx",
    "tui:check": "tsc -p tsconfig.opentui.json --noEmit",
    "tui:smoke": "bun run ./tui/opentui/renderSmoke.tsx && bun run ./tui/opentui/gitPopoverSmoke.tsx",
    "tui:ink": "node --import tsx ./tui/main.tsx",
    "tui:ink:dev": "node --watch --import tsx ./tui/main.tsx",
    "regen-codex-schema": "rm -rf lib/codex-schema && codex app-server generate-ts --experimental --out lib/codex-schema",
    "seed-prompts": "node ./scripts/seed-prompts.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.198",
    "@earendil-works/pi-agent-core": "^0.80.3",
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@github/copilot-sdk": "^1.0.5",
    "@inkjs/ui": "^2.0.0",
    "@opencode-ai/sdk": "^1.17.13",
    "@opentui/core": "^0.4.2",
    "@opentui/react": "^0.4.2",
    "@pierre/diffs": "^1.2.12",
    "@pierre/trees": "^1.0.0-beta.5",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.0",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "next": "^16.2.10",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.9.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.16",
    "react-doctor": "^0.5.8",
    "shadcn": "^4.12.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "ws": "^8.21.0",
    "protobufjs": "^7.6.4"
  }
}
