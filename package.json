{
  "name": "agent-viewer",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "agent-viewer": "./bin/agent-viewer.mjs"
  },
  "files": [
    "README.md",
    "app",
    "bin",
    "components",
    "components.json",
    "instrumentation.ts",
    "lib",
    "next-env.d.ts",
    "next.config.ts",
    "package.json",
    "postcss.config.mjs",
    "proxy.ts",
    "tsconfig.json",
    "tsconfig.opentui.json",
    "tsconfig.tui.json",
    "tui",
    "workers"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "tsc --noEmit && next build",
    "start": "next start",
    "tui": "bun run ./tui/opentui/main.tsx",
    "tui:dev": "bun --watch ./tui/opentui/main.tsx",
    "tui:check": "tsc -p tsconfig.opentui.json --noEmit",
    "tui:smoke": "bun run ./tui/opentui/renderSmoke.tsx && bun run ./tui/opentui/gitPopoverSmoke.tsx && bun run ./tui/opentui/appSmoke.tsx && bun run ./tui/opentui/fleetSmoke.tsx && bun run ./tui/opentui/coordPromptSmoke.ts && bun run ./tui/opentui/coordSmoke.tsx && bun run ./tui/opentui/externalCoordSmoke.ts && bun run ./tui/opentui/piPoolSmoke.tsx",
    "mcp:smoke": "node ./scripts/mcpBridgeSmoke.mjs && node ./scripts/coordWorkerSmoke.mjs && node ./scripts/coordStateSmoke.mjs",
    "tui:ink": "node --import tsx ./tui/main.tsx",
    "tui:ink:dev": "node --watch --import tsx ./tui/main.tsx",
    "regen-codex-schema": "rm -rf lib/codex-schema && codex app-server generate-ts --experimental --out lib/codex-schema",
    "seed-prompts": "node ./scripts/seed-prompts.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.210",
    "@anthropic-ai/sdk": "^0.111.0",
    "@earendil-works/pi-agent-core": "^0.80.7",
    "@earendil-works/pi-ai": "^0.80.7",
    "@earendil-works/pi-coding-agent": "^0.80.7",
    "@github/copilot-sdk": "^1.0.6",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "^1.18.1",
    "@opentui/core": "^0.4.3",
    "@opentui/react": "^0.4.3",
    "@pierre/diffs": "^1.2.12",
    "@pierre/trees": "^1.0.0-beta.5",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.0",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "next": "^16.2.10",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "postcss": "^8.5.19",
    "react-doctor": "^0.7.8",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "ws": "^8.21.0",
    "protobufjs": "^8.6.6"
  }
}
