{
  "name": "agent-viewer",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "agent-viewer": "./bin/agent-viewer.mjs"
  },
  "files": [
    ".agents/skills/coordinate-agents",
    "README.md",
    "app",
    "bin",
    "components",
    "components.json",
    "instrumentation.ts",
    "lib",
    "next-env.d.ts",
    "next.config.ts",
    "package.json",
    "postcss.config.mjs",
    "proxy.ts",
    "tsconfig.json",
    "tsconfig.opentui.json",
    "tsconfig.tui.json",
    "tui",
    "workers"
  ],
  "scripts": {
    "dev": "node ./bin/agent-viewer.mjs web",
    "build": "tsc --noEmit && next build",
    "start": "node ./bin/agent-viewer.mjs web --production",
    "tui": "bun run ./tui/opentui/main.tsx",
    "tui:dev": "bun --watch ./tui/opentui/main.tsx",
    "tui:check": "tsc -p tsconfig.opentui.json --noEmit",
    "tui:smoke": "node ./scripts/withoutEnv.mjs AGENT_VIEWER_ATTACH AGENT_VIEWER_COORD_WORKER AGENT_VIEWER_COORD_IDENTITY_FILE -- npm run tui:smoke:run",
    "tui:smoke:run": "bun run ./scripts/composerInputSmoke.ts && bun run ./tui/opentui/transcriptSelectionSmoke.tsx && bun run ./tui/opentui/splitPaneSmoke.ts && bun run ./tui/opentui/controlCenterTranscriptSmoke.ts && bun run ./tui/opentui/composerDraftSmoke.ts && bun run ./tui/opentui/renderSmoke.tsx && bun run ./tui/opentui/gitPopoverSmoke.tsx && bun run ./tui/opentui/appSmoke.tsx && bun run ./tui/opentui/questionPickerSmoke.tsx && bun run ./tui/opentui/codexQuestionStreamSmoke.tsx && bun run ./tui/opentui/liveToolStreamSmoke.tsx && bun run ./tui/opentui/fleetSmoke.tsx && bun run ./tui/opentui/coordPromptSmoke.ts && bun run ./tui/opentui/coordRemoteSmoke.ts && bun run ./tui/opentui/coordSmoke.tsx && bun run ./tui/opentui/coordinatorSidebarSmoke.tsx && bun run ./tui/opentui/externalCoordSmoke.ts && bun run ./tui/opentui/piPoolSmoke.tsx",
    "mcp:smoke": "node ./scripts/mcpBridgeSmoke.mjs && node ./scripts/mcpAhpCoordinatorSmoke.mjs && node ./scripts/coordWorkerSmoke.mjs && node ./scripts/coordStateSmoke.mjs",
    "ahp:smoke": "bun run ./scripts/ahpSmoke.ts",
    "composer:smoke": "bun run ./scripts/composerInputSmoke.ts && bun run ./scripts/piExtensionUiSmoke.ts && bun run ./scripts/webComposerQueueSmoke.ts && bun run ./scripts/composerBenchmarkCompareSmoke.ts",
    "composer:benchmark": "bun run ./scripts/composerLiveBenchmark.ts",
    "composer:benchmark:native": "bun run ./scripts/composerNativeBenchmark.ts",
    "composer:benchmark:compare": "bun run ./scripts/composerBenchmarkCompare.ts",
    "composer:perf": "bun run ./scripts/composerLocalPerf.ts",
    "tui:ink": "node --import tsx ./tui/main.tsx",
    "tui:ink:dev": "node --watch --import tsx ./tui/main.tsx",
    "regen-codex-schema": "rm -rf lib/codex-schema && codex app-server generate-ts --experimental --out lib/codex-schema",
    "codex:schema:smoke": "bun run ./scripts/codexSchemaAlignmentSmoke.ts",
    "seed-prompts": "node ./scripts/seed-prompts.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@github/copilot-sdk": "^1.0.8",
    "@hono/node-server": "^2.0.12",
    "@inkjs/ui": "^2.0.0",
    "@microsoft/agent-host-protocol": "^0.6.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opencode-ai/sdk": "^1.18.10",
    "@opentui/core": "^0.4.5",
    "@opentui/react": "^0.4.5",
    "@pierre/diffs": "^1.3.1",
    "@pierre/trees": "^1.0.0-beta.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.1",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.7",
    "next": "^16.2.12",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "postcss": "^8.5.25",
    "react-doctor": "^0.9.2",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "ws": "^8.21.0",
    "protobufjs": "^8.6.6"
  }
}
