{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "react"],
    "noEmit": true
  },
  "include": [
    "tui/**/*.ts",
    "tui/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx"
  ]
}
