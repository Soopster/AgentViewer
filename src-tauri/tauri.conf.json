{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Viewer",
  "version": "0.1.0",
  "identifier": "dev.agentviewer.desktop",
  "build": {
    "frontendDist": "../src-tauri-ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Viewer",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/next-standalone": "next-standalone"
    },
    "externalBin": [
      "binaries/agent-viewer-ahp"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
