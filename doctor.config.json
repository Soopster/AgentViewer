{
  "$schema": "https://www.react.doctor/schema.json",
  "ignore": {
    "files": ["tmp/**", ".agents/**", "tui/opentui/*Smoke.ts", "tui/opentui/*Smoke.tsx"],
    "overrides": [
      { "files": ["components/CodeRenderers.tsx"], "rules": ["react-doctor/no-danger"] },
      { "files": ["components/MessageView.tsx"], "rules": ["react-doctor/effect-needs-cleanup", "react-doctor/no-unowned-async-error-clear"] },
      { "files": ["tui/opentui/App.tsx"], "rules": ["react-doctor/effect-needs-cleanup", "react-doctor/no-loading-flag-reset-outside-finally", "react-doctor/no-set-state-after-await-in-effect"] },
      { "files": ["tui/**"], "rules": ["react-doctor/no-placeholder-only-field"] },
      { "files": ["app/page.tsx"], "rules": ["react-doctor/no-side-effect-in-state-updater-function", "react-doctor/no-loading-flag-reset-outside-finally"] },
      { "files": ["tui/App.tsx"], "rules": ["react-doctor/no-loading-flag-reset-outside-finally"] },
      { "files": ["bin/agent-viewer-mcp.mjs", "channels/agentviewer-channel.ts"], "rules": ["react-doctor/mcp-tool-capability-risk"] },
      { "files": ["bin/agent-viewer.mjs", "lib/checkpoints.ts"], "rules": ["react-doctor/local-rpc-native-bridge-risk"] },
      { "files": ["lib/opencodePlugin/agentViewerCoordinator.mjs"], "rules": ["react-doctor/agent-tool-capability-risk"] },
      { "files": ["lib/agentCoordination.ts"], "rules": ["react-doctor/path-traversal-risk"] },
      { "files": ["lib/sessionBackend.ts"], "rules": ["react-doctor/insecure-crypto-risk"] },
      { "files": ["channels/agentviewer-channel.ts", "channels/agentviewer-ide.ts", "lib/sqliteReadWorker.mjs"], "rules": ["deslop/unused-file"] },
      { "files": ["lib/bridgeMessages.ts", "lib/checkpoints.ts", "lib/copilotClient.ts", "lib/ideBridge.ts", "lib/messageBookmarks.ts", "lib/acpAgentSpawn.ts", "lib/acpClientPool.ts", "lib/claudeUsageLimits.ts", "lib/linkedPullRequests.ts", "lib/liveSessionHarness.ts", "lib/opencodeSessions.ts", "lib/piClient.ts", "lib/providerInstances.ts", "lib/remoteAuth.ts", "lib/remoteEndpoints.ts", "lib/sessionInbox.ts", "lib/terminalSession.ts"], "rules": ["deslop/unused-export"] },
      { "files": ["lib/adapters/claude.ts"], "rules": ["deslop/circular-dependency"] },
      { "files": ["tui/opentui/SurfaceViews.tsx"], "rules": ["react-doctor/effect-needs-cleanup"] },
      { "files": ["tui/opentui/editorCompletionPerf.tsx", "tui/opentui/navPerf.tsx"], "rules": ["react-doctor/no-impure-call-at-module-scope"] },
      { "files": ["tui/opentui/editorSearch.ts"], "rules": ["react-doctor/no-unescaped-dynamic-string-in-regexp"] },
      { "files": ["package.json"], "rules": ["deslop/unused-dependency"] },
      { "files": ["components/ui/tabs.tsx"], "rules": ["react-doctor/only-export-components"] }
    ]
  },
  "rules": {
    "react-doctor/no-unknown-property": "off",
    "react-doctor/no-uncontrolled-input": "off",
    "react-doctor/no-many-boolean-props": "off",
    "react-doctor/no-pass-data-to-parent": "off",
    "react-doctor/no-prop-callback-in-effect": "off",
    "react-doctor/no-pass-live-state-to-parent": "off",
    "react-doctor/no-derived-state-effect": "off",

    "react-doctor/no-tiny-text": "off",
    "react-doctor/no-wide-letter-spacing": "off",
    "react-doctor/no-inline-exhaustive-style": "off",
    "react-doctor/no-multi-comp": "off",
    "react-doctor/no-giant-component": "off",
    "react-doctor/no-side-tab-border": "off",
    "react-doctor/no-z-index-9999": "off",
    "react-doctor/no-outline-none": "off",
    "react-doctor/prefer-html-dialog": "off",
    "react-doctor/design-no-three-period-ellipsis": "off",
    "react-doctor/design-no-em-dash-in-jsx-text": "off",
    "react-doctor/design-no-redundant-padding-axes": "off",

    "react-doctor/nextjs-missing-metadata": "off",
    "react-doctor/nextjs-no-img-element": "off",
    "react-doctor/nextjs-no-client-fetch-for-server-data": "off",
    "react-doctor/no-fetch-in-effect": "off",

    "react-doctor/no-adjust-state-on-prop-change": "off",
    "react-doctor/no-derived-state": "off",
    "react-doctor/no-chain-state-updates": "off",
    "react-doctor/no-event-handler": "off",
    "react-doctor/no-cascading-set-state": "off",
    "react-doctor/no-effect-chain": "off",
    "react-doctor/prefer-useReducer": "off",
    "react-doctor/prefer-use-effect-event": "off",
    "react-doctor/no-initialize-state": "off",

    "react-doctor/no-array-index-as-key": "off",
    "react-doctor/no-array-index-key": "off",
    "react-doctor/exhaustive-deps": "off",

    "react-doctor/click-events-have-key-events": "off",
    "react-doctor/no-static-element-interactions": "off",
    "react-doctor/control-has-associated-label": "off",
    "react-doctor/interactive-supports-focus": "off",
    "react-doctor/label-has-associated-control": "off",
    "react-doctor/prefer-tag-over-role": "off",

    "react-doctor/js-tosorted-immutable": "off",
    "react-doctor/js-combine-iterations": "off",
    "react-doctor/js-flatmap-filter": "off",
    "react-doctor/js-set-map-lookups": "off",
    "react-doctor/js-min-max-loop": "off",
    "react-doctor/js-cache-property-access": "off",
    "react-doctor/js-index-maps": "off",
    "react-doctor/js-hoist-intl": "off",
    "react-doctor/async-await-in-loop": "off",
    "react-doctor/async-defer-await": "off",
    "react-doctor/async-parallel": "off",
    "react-doctor/server-sequential-independent-await": "off",
    "react-doctor/no-long-transition-duration": "off",
    "react-doctor/no-layout-transition-inline": "off",
    "react-doctor/rendering-hydration-no-flicker": "off",
    "react-doctor/rerender-functional-setstate": "off",
    "react-doctor/rerender-state-only-in-handlers": "off",
    "react-doctor/advanced-event-handler-refs": "off",
    "react-doctor/prefer-dynamic-import": "off",

    "deslop/unused-dev-dependency": "off"
  }
}
